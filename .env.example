# Local zero-dependency smoke test (in-memory SQS stub).
#   cp .env.example .env
#   set -a && source .env && set +a
#   export TOKEN=demo
#   python -m uvicorn dev.main:app --port 8085

SERVICE=demo-service
ENVIRONMENT=dev
USER_ID=local
USER_NAME=Local User
SHOW_MESSAGE_CONTENT=true
AUDIT_LOG_PATH=/tmp/aws-tools.audit
SQS_STUB_SAMPLE_COUNT=3
SQS_QUEUES=[{"name":"orders","arn":"arn:aws:sqs:eu-west-2:000000000000:orders","deadletter_queue_arn":"arn:aws:sqs:eu-west-2:000000000000:orders-deadletter"}]

# Optional: LocalStack/Floci instead of in-memory stub (run app.main:app instead).
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
AWS_REGION=eu-west-2
# AWS_ENDPOINT_URL=http://localhost:4566
